<UserControl x:Class="Start.UI.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Start.UI.Views"
             xmlns:vm="clr-namespace:Start.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <DockPanel Margin="0,0,0,15">
            <Button Command="{Binding BackCommand}"
                    Content="Back to Search"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <TextBlock Text="Downloads Queue" Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
        </DockPanel>
        
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="0,0,0,10" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" Height="60"/>
                                
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                    
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="10" VerticalAlignment="Center" Grid.Column="1"/>
                                        <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" Margin="10,0,0,0" Grid.Column="2"/>
                                    </Grid>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Speed}" FontSize="11" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Eta}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}" 
                                            ToolTip="Cancel">
                                        <materialDesign:PackIcon Kind="Close"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}" 
                                            ToolTip="Retry">
                                        <materialDesign:PackIcon Kind="Refresh"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
