<UserControl x:Class="Start.UI.Views.AddDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:Start.UI.ViewModels"
             xmlns:converters="clr-namespace:Start.UI.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:AddDownloadViewModel}"
             Background="#0b0f19" Foreground="White"
             materialDesign:ThemeAssist.Theme="Dark"
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <viewmodels:EpisodeColorConverter x:Key="EpisodeColorConverter"/>
        <viewmodels:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <viewmodels:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <viewmodels:ImageUrlConverter x:Key="ImageUrlConverter" />
        <viewmodels:ProgressWidthConverter x:Key="ProgressWidthConverter" />
        <viewmodels:JobStatusToColorConverter x:Key="JobStatusToColorConverter" />
        <viewmodels:JobStatusToStopVisConverter x:Key="JobStatusToStopVisConverter" />
        
        <Style x:Key="LogTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New, monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Background" Value="#0e1220" />
        </Style>

        <SolidColorBrush x:Key="MaterialDesignPaper" Color="#151928" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="145"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: Drama Details & Action Controls -->
        <Border Grid.Row="0" Grid.Column="0" Background="#151928" BorderBrush="#242b45" BorderThickness="1" Margin="10,10,5,8" CornerRadius="8">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,5">
                    <StackPanel>
                        <!-- Active Platform Indicator -->
                        <Border Background="#101424" BorderBrush="#252d47" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▶ " Foreground="{Binding SelectedPlatform.IconColor}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedPlatform.Name}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#1b3d2f" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Ready" Foreground="#00b894" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Drama Poster Area -->
                        <Border BorderBrush="#252d47" BorderThickness="1" CornerRadius="8" Height="170" Background="#0f1322" Margin="0,0,0,12" ClipToBounds="True">
                            <Grid>
                                <!-- Placeholder icon when no poster -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🎬" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Media Preview" Foreground="#556080" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <!-- Real Image when loaded -->
                                <Image Source="{Binding CurrentPosterUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        
                        <!-- Drama Title -->
                        <TextBlock Text="{Binding CurrentDramaTitle}" FontWeight="Bold" Foreground="White" FontSize="13" 
                                   HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap" TextAlignment="Center"/>
                        
                        <!-- Episode & Selection Stats -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0f1322" BorderBrush="#252d47" BorderThickness="1" CornerRadius="6" Padding="8,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalEpisodes}" Foreground="#00cec9" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Total Episodes" Foreground="#8a99b5" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#0f1322" BorderBrush="#252d47" BorderThickness="1" CornerRadius="6" Padding="8,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedCount}" Foreground="#a29bfe" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Selected" Foreground="#8a99b5" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quality Selection (Shown when options exist) -->
                        <StackPanel Visibility="{Binding AvailableQualities.Count, Converter={StaticResource CountToVisibilityConverter}}" Margin="0,0,0,12">
                            <TextBlock Text="VIDEO QUALITY" Foreground="#8a99b5" FontSize="10" FontWeight="Bold" Margin="2,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableQualities}" SelectedItem="{Binding SelectedQuality}"
                                      Background="#0f1322" Foreground="White" BorderBrush="#252d47" BorderThickness="1" 
                                      Padding="8,6" FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="White"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Destination Folder -->
                        <StackPanel Margin="0,0,0,8">
                            <Grid Margin="2,0,0,4">
                                <TextBlock Text="SAVE LOCATION" Foreground="#8a99b5" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="📂 Browse" Command="{Binding BrowseFolderCommand}" 
                                        Background="#20263f" Foreground="#f1c40f" BorderThickness="0" 
                                        Padding="8,2" Height="20" FontSize="10" FontWeight="SemiBold" 
                                        HorizontalAlignment="Right" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                            <TextBox Text="{Binding SavePath}" Background="#0f1322" Foreground="White" BorderBrush="#252d47" 
                                     BorderThickness="1" Padding="8,6" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action Buttons at bottom of sidebar -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Content="📥 Download Selected" Command="{Binding StartDownloadCommand}" 
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            FontWeight="Bold" Foreground="White" BorderThickness="0" Margin="0,0,0,8" Height="40" Cursor="Hand">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00b894" Offset="0"/>
                                <GradientStop Color="#0984e3" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Cancel / Reset" Command="{Binding BackToTrendingCommand}" 
                            Background="#20263f" Foreground="#8a99b5" BorderThickness="0" Height="30" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT WORKSPACE: Search Bar, Episodes Grid & Active Downloads -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="5,10,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- Search & Platform Toolbar -->
            <Border Grid.Row="0" Background="#151928" BorderBrush="#242b45" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Platform Selector -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Source:" Foreground="#8a99b5" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}" 
                                  Width="140" Background="#0f1322" Foreground="White" FontSize="12" 
                                  BorderBrush="#252d47" Padding="8,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶ " Foreground="{Binding IconColor}" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Column="1" Background="#252d47" Margin="0,2,12,2"/>

                    <!-- URL Input Box -->
                    <TextBox Grid.Column="2" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#0f1322" Foreground="White" BorderBrush="#252d47" BorderThickness="1" 
                             Padding="12,8" VerticalContentAlignment="Center" FontSize="13"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             materialDesign:HintAssist.Hint="Paste drama URL, episode link, or book ID (e.g. https://www.iq.com/...)..."/>
                    
                    <!-- Search Button -->
                    <Button Grid.Column="3" Content="🔍 Search" Command="{Binding FetchUrlCommand}" 
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            Margin="10,0,0,0" Width="105" FontWeight="Bold" Foreground="White" BorderThickness="0" Cursor="Hand" Height="38">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6c5ce7" Offset="0"/>
                                <GradientStop Color="#d946ef" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Center Content Area (Hero Onboarding Card OR Episode Grid) -->
            <Border Grid.Row="1" Background="#151928" BorderBrush="#242b45" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                <Grid>
                    <!-- Hero Welcome State (when no drama is analyzed) -->
                    <Grid Visibility="{Binding ShowsTrending, Converter={StaticResource BoolToVis}}" Margin="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="#1c2238" CornerRadius="40" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Ready to Download" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Paste a video URL or series link above to analyze available streams and episodes" 
                                       Foreground="#8a99b5" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <!-- Supported Platform Pills -->
                            <WrapPanel HorizontalAlignment="Center" MaxWidth="600" Margin="0,0,0,20">
                                <Border Background="#101424" BorderBrush="#00cc4c" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="4">
                                    <TextBlock Text="iQiyi (iq.com)" Foreground="#00cc4c" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border Background="#101424" BorderBrush="#ff522e" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="4">
                                    <TextBlock Text="DramaBox" Foreground="#ff522e" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border Background="#101424" BorderBrush="#f39c12" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="4">
                                    <TextBlock Text="Iflix" Foreground="#f39c12" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border Background="#101424" BorderBrush="#0984e3" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="4">
                                    <TextBlock Text="NetShort" Foreground="#0984e3" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border Background="#101424" BorderBrush="#e84393" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="4">
                                    <TextBlock Text="KissKH" Foreground="#e84393" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border Background="#101424" BorderBrush="#ff0000" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="4">
                                    <TextBlock Text="YouTube" Foreground="#ff0000" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border Background="#101424" BorderBrush="#00cec9" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="4">
                                    <TextBlock Text="TikTok" Foreground="#00cec9" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border Background="#101424" BorderBrush="#00a8ff" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="4">
                                    <TextBlock Text="Bilibili" Foreground="#00a8ff" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </WrapPanel>

                            <!-- Feature Tags -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Background="#101424" CornerRadius="4" Padding="8,4" Margin="4,0">
                                    <TextBlock Text="⚡ Multi-Threaded Parallel Chunking" Foreground="#74b9ff" FontSize="11"/>
                                </Border>
                                <Border Background="#101424" CornerRadius="4" Padding="8,4" Margin="4,0">
                                    <TextBlock Text="🔑 iQiyi VIP Multi-Account Vault" Foreground="#00b894" FontSize="11"/>
                                </Border>
                                <Border Background="#101424" CornerRadius="4" Padding="8,4" Margin="4,0">
                                    <TextBlock Text="📋 Clipboard Auto-Capture" Foreground="#fdcb6e" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Episodes View (when drama is fetched) -->
                    <Grid Margin="15" Visibility="{Binding ShowsTrending, Converter={StaticResource InverseBooleanConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&lt; Back" Command="{Binding BackToTrendingCommand}" 
                                        Background="#20263f" Foreground="White" BorderThickness="0" 
                                        Padding="10,5" FontSize="11" Margin="0,0,15,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock Text="Episodes" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                <Border Background="#101424" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalEpisodes, StringFormat='1 - {0}'}" Foreground="#ff7675" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Select All" Command="{Binding SelectAllNodesCommand}" 
                                        Background="#20263f" Foreground="#00cec9" BorderThickness="0" 
                                        Padding="12,5" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Select None" Command="{Binding SelectNoneNodesCommand}" 
                                        Background="#20263f" Foreground="#8a99b5" BorderThickness="0" 
                                        Padding="12,5" FontSize="11" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Episodes Wrap Grid -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Episodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemWidth="52" ItemHeight="36"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="2" Padding="2" 
                                                Command="{Binding DataContext.ToggleEpisodeSelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                CommandParameter="{Binding}" BorderThickness="0" Cursor="Hand">
                                            <Button.Background>
                                                <SolidColorBrush Color="{Binding IsSelected, Converter={StaticResource EpisodeColorConverter}}"/>
                                            </Button.Background>
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="🔒" Foreground="#ffcc00" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0" 
                                                           Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding EpisodeNumber}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom Active Downloads Card -->
            <Border Grid.Row="2" Background="#151928" BorderBrush="#242b45" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Active Downloads" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Progress stays here while you keep browsing" Foreground="#8a99b5" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Visibility="{Binding HasDownloadJobs, Converter={StaticResource InverseBooleanConverter}}">
                        <TextBlock Text="No active downloads in progress. Select episodes and click Download Selected." 
                                   Foreground="#556080" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDownloadJobs, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding DownloadJobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>

                                        <Border CornerRadius="4" Background="#0f1322" ClipToBounds="True" Width="34" Height="34">
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Status}" Foreground="#8a99b5" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                <!-- Two-layer progress bar -->
                                                <Border Grid.Column="1" CornerRadius="3" Height="6" Background="#20263f" VerticalAlignment="Center" x:Name="ProgressTrack">
                                                    <Grid>
                                                        <Border CornerRadius="3" HorizontalAlignment="Left"
                                                                Background="{Binding Status, Converter={StaticResource JobStatusToColorConverter}}">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                                    <Binding Path="Progress"/>
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"/>
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding Speed}" Foreground="#8a99b5" FontSize="10" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Progress, StringFormat={}{0:0}%}" Foreground="#00cec9" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- Cancel download button -->
                                        <Button Grid.Column="3"
                                                Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource JobStatusToStopVisConverter}}"
                                                Background="#c0392b" Foreground="White" BorderThickness="0"
                                                Width="22" Height="22" Padding="0" Cursor="Hand"
                                                ToolTip="Stop download"
                                                FontSize="10" FontWeight="Bold" Content="✕"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM CONSOLE LOGS TERMINAL -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0c0f1a" BorderBrush="#242b45" BorderThickness="0,1,0,0">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Terminal Logs" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="#1b3d2f" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Live" Foreground="#00b894" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📋 Copy Log" Command="{Binding CopyLogCommand}" 
                                Background="#1e243a" Foreground="#00cec9" BorderThickness="0" 
                                Padding="10,3" Margin="0,0,8,0" Height="24" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                ToolTip="Copy all console log lines to clipboard">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Clear" Command="{Binding ClearLogsCommand}" 
                                Background="Transparent" Foreground="#8a99b5" 
                                Padding="8,3" BorderThickness="0" Height="24" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
                
                <ScrollViewer x:Name="LogViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" Style="{StaticResource LogTextStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
